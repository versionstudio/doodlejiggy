  "scripts": {
    "scene_setup": {
      "steps": [
        { "action": "spawnObject", "object": "doorway_light", "x": 300, "y": 319.7 },
        { "action": "spawnActor", "actor": "observer", "x": 195, "y": 250 },
        { "action": "spawnActor", "actor": "terminal", "x": 291, "y": 180 }
      ]
    },

    "chamber_remark": {
      "cutscene": true,
      "steps": [
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "object": "terminal", "text": "CHAMBER ACCESS ENABLED." },
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "ego", "text": "What... is this place?" },
        { "action": "wait", "seconds": 0.9 },
        { "action": "cameraFollow", "actor": "observer", "lerp": 2 },
        { "action": "say", "actor": "observer", "text": "I've had a long time to think about that." },
        { "action": "cameraFollow", "actor": "ego", "lerp": 2 },
        { "action": "setFlag", "flag": "chamber_remark_done" }
      ]
    },

    "whiteboard_examine": {
      "steps": [
        { "action": "setFlag", "flag": "whiteboard_seen" }
      ]
    },

    "photographs_examine": {
      "steps": [
        { "action": "setFlag", "flag": "photographs_seen" }
      ]
    },

    "clues_examine": {
      "steps": [
        { "action": "setFlag", "flag": "clues_seen" }
      ]
    },

    "terminal_examine": {
      "cutscene": true,
      "steps": [
        { "action": "say", "actor": "ego", "text": "I don't think it'd be polite to use someone else's terminal." },
        { "action": "say", "actor": "ego", "text": "Especially while they're standing right there." }
      ]
    },

    "terminal_use": {
      "steps": [
        { "action": "talkTo", "target": "terminal" }
      ]
    },

    "terminal_sequence": {
      "cutscene": true,
      "steps": [
        { "action": "wait", "seconds": 1 },
        { "action": "say", "actor": "ego", "text": "...You're kidding." },
        { "action": "wait", "seconds": 0.4 },
        { "action": "say", "actor": "terminal", "text": "IDENTIFICATION..." },
        { "action": "wait", "seconds": 1 },
        { "action": "say", "actor": "terminal", "text": "WELCOME BACK." },
        { "action": "wait", "seconds": 0.4 },
        { "action": "say", "actor": "ego", "text": "Welcome back?" },
        { "action": "wait", "seconds": 0.6 },
        { "action": "say", "actor": "terminal", "text": "ITERATION COMPLETE." },
        { "action": "wait", "seconds": 1 },
        { "action": "say", "actor": "terminal", "text": "ACTIVATING CELEBRATION PROTOCOL." },
        { "action": "wait", "seconds": 0.8 },
        { "action": "spawnObject", "object": "confetti", "x": 287, "y": 178, "persist": false },
        { "action": "waitForAnimation", "object": "confetti" },
        { "action": "removeObject", "object": "confetti" },
        { "action": "wait", "seconds": 1 },
        { "action": "face", "actor": "ego", "facing": "south" },
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "ego", "text": "Uh... what is happening?" },
        { "action": "wait", "seconds": 1 },
        { "action": "say", "actor": "terminal", "text": "LAST ITERATION RUNTIME: 3,847 YEARS." },
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "terminal", "text": "SUCCESS CONDITIONS MET." },
        { "action": "face", "actor": "ego", "facing": "west" },
        { "action": "wait", "seconds": 0.8 },
        { "action": "say", "actor": "terminal", "text": "PREPARING NEXT ITERATION." },
        { "action": "wait", "seconds": 0.5 },
        { "action": "walkTo", "actor": "ego", "x": 243, "y": 250 },
        { "action": "wait", "seconds": 1 },
        { "action": "say", "actor": "ego", "text": "Hey you." },
        { "action": "wait", "seconds": 0.4 },
        { "action": "say", "actor": "ego", "text": "What is happening?" },
        { "action": "wait", "seconds": 0.8 },
        { "action": "say", "actor": "terminal", "text": "SECURING CHAMBER ACCESS." },
        { "action": "face", "actor": "ego", "facing": "south" },
        { "action": "wait", "seconds": 0.7 },
        { "action": "removeObject", "object": "doorway_light" },
        { "action": "wait", "seconds": 1 },
        { "action": "say", "actor": "ego", "text": "Did it just lock me in?" },
        { "action": "wait", "seconds": 0.8 },
        { "action": "say", "actor": "terminal", "text": "ACTIVATING SUCCESSION PROTOCOL." },
        { "action": "wait", "seconds": 0.8 },
        { "action": "teleport", "actor": "observer", "x": 195, "y": 251 },
        { "action": "wait", "seconds": 0.06 },
        { "action": "removeActor", "actor": "observer" },
        { "action": "wait", "seconds": 0.06 },
        { "action": "spawnActor", "actor": "observer", "x": 195, "y": 250, "state": "default" },
        { "action": "wait", "seconds": 0.06 },
        { "action": "removeActor", "actor": "observer" },
        { "action": "wait", "seconds": 3 },
        { "action": "say", "actor": "ego", "text": "...No." },
        { "action": "wait", "seconds": 2 },
        { "action": "changeScene", "scene": "epilogue", "entry": "hidden" }
      ]
    },

    "observer_reveal": {
      "cutscene": true,
      "steps": [
        { "action": "setActorState", "actor": "observer", "state": "revealed", "persist": true },
        { "action": "setFlag", "flag": "observer_revealed" },
        { "action": "wait", "seconds": 0.5 },
        { "action": "face", "actor": "ego", "facing": "south" },
        { "action": "say", "actor": "ego", "text": "Hmm." },
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "ego", "text": "Whoever... or whatever that is." },
        { "action": "say", "actor": "ego", "text": "It's been here a long time... observing." },
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "observer", "text": "..." }
      ]
    },

    "nosy_box_entrance": {
      "cutscene": true,
      "steps": [
        { "action": "face", "actor": "ego", "facing": "south" },
        { "action": "wait", "seconds": 0.8 },
        { "action": "spawnActor", "actor": "nosy_box", "x": 372, "y": 293, "state": "invisible" },
        { "action": "say", "actor": "nosy_box", "text": "*clank*", "effect": "shake", "duration": 0.9 },
        { "action": "wait", "seconds": 0.2 },
        { "action": "say", "actor": "ego", "text": "Hello?" },
        { "action": "wait", "seconds": 0.3 },
        { "action": "walkTo", "actor": "ego", "x": 243, "y": 296 },
        { "action": "face", "actor": "ego", "facing": "east" },
        { "action": "wait", "seconds": 0.55 },
        { "action": "teleport", "actor": "nosy_box", "x": 300, "y": 292 },
        { "action": "say", "actor": "nosy_box", "text": "*clank*", "effect": "shake", "duration": 0.7 },
        { "action": "wait", "seconds": 0.38 },
        { "action": "teleport", "actor": "nosy_box", "x": 348, "y": 289 },
        { "action": "say", "actor": "nosy_box", "text": "*clank*", "effect": "shake", "duration": 0.7 },
        { "action": "wait", "seconds": 0.24 },
        { "action": "teleport", "actor": "nosy_box", "x": 322, "y": 286 },
        { "action": "say", "actor": "nosy_box", "text": "*clank*", "effect": "shake", "duration": 0.7 },
        { "action": "wait", "seconds": 0.14 },
        { "action": "teleport", "actor": "nosy_box", "x": 350, "y": 280 },
        { "action": "say", "actor": "nosy_box", "text": "*clank*", "effect": "shake", "duration": 0.7 },
        { "action": "cameraFollow", "actor": "nosy_box", "lerp": 2 },
        { "action": "spawnActor", "actor": "nosy_box", "entry": "from_home", "state": "mobile" },
        { "action": "wait", "seconds": 0.8 },
        { "action": "say", "actor": "nosy_box", "text": "Oh." },
        { "action": "wait", "seconds": 0.4 },
        { "action": "say", "actor": "nosy_box", "text": "So this is how it looks." },
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "ego", "text": "Where did those legs come from?" },
        { "action": "wait", "seconds": 0.3 },
        { "action": "say", "actor": "nosy_box", "text": "These?" },
        { "action": "wait", "seconds": 0.2 },
        { "action": "say", "actor": "nosy_box", "text": "They've always been there." },
        { "action": "wait", "seconds": 0.8 },
        { "action": "say", "actor": "ego", "text": "...Right." },
        { "action": "wait", "seconds": 0.8 },
        { "action": "spawnObject", "object": "antenna", "x": 340, "y": 306, "persist": false, "state": "deploy_north" },
        { "action": "waitForAnimation", "object": "antenna" },
        { "action": "setObjectState", "object": "antenna", "state": "sweep_north" },
        { "action": "wait", "seconds": 1.5 },
        { "action": "say", "actor": "nosy_box", "text": "Interesting." },
        { "action": "wait", "seconds": 1.5 },
        { "action": "say", "actor": "nosy_box", "text": "Have you used that terminal yet?" },
        { "action": "say", "actor": "ego", "text": "It wants a password." },
        { "action": "wait", "seconds": 0.4 },
        { "action": "say", "actor": "nosy_box", "text": "Oh." },
        { "action": "wait", "seconds": 1 },
        { "action": "say", "actor": "nosy_box", "text": "You did try 'admin', didn't you?" },
        { "action": "wait", "seconds": 0.8 },
        { "action": "say", "actor": "ego", "text": "...No." },
        { "action": "wait", "seconds": 0.4 },
        { "action": "say", "actor": "nosy_box", "text": "It's what I use." },
        { "action": "wait", "seconds": 1.2 },
        { "action": "say", "actor": "ego", "text": "...Seriously?" },
        { "action": "wait", "seconds": 0.6 },
        { "action": "say", "actor": "nosy_box", "text": "It's worked every time so far." },
        { "action": "wait", "seconds": 1 },
        { "action": "setObjectState", "object": "antenna", "state": "undeploy_north" },
        { "action": "waitForAnimation", "object": "antenna" },
        { "action": "removeObject", "object": "antenna" },
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "nosy_box", "text": "Anyway." },
        { "action": "wait", "seconds": 0.3 },
        { "action": "say", "actor": "nosy_box", "text": "These legs won't test themselves." },
        { "action": "wait", "seconds": 0.7 },
        { "action": "cameraFollow", "actor": "ego", "lerp": 2 },
        { "action": "removeActor", "actor": "nosy_box", "exit": "to_home" },
        { "action": "wait", "seconds": 0.8 },
        { "action": "face", "actor": "ego", "facing": "south" },
        { "action": "wait", "seconds": 1 },
        { "action": "say", "actor": "ego", "text": "I have a feeling that's going to come back and haunt me." },
        { "action": "setFlag", "flag": "terminal_password" }
      ]
    }
  },

