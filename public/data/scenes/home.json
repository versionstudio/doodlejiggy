  "ambientBarks": {
    "nosy_box": [
      { "ifNot": "nosy_box_upgraded",
        "interval": [35, 70],
        "lines": [
          "*faint static*",
          "*quiet listening sounds*",
          "*friendly little beep*",
          "*faint digital throat-clearing*",
          "*soft calibration noises*",
          "*processing noises*",
          "*light observing noises*",
          "*pleasant surveillance humming*",
          "*brief analytical pause*",
          "I noticed that.",
          "Interesting.",
          "Hmm."
        ]
      },
      { "if": "nosy_box_upgraded",
        "interval": [35, 70],
        "lines": [
          "*faint antenna noises*",
          "*quiet predictive pulse*",
          "*soft signal sweep*",
          "*subtle retrieval chirp*",
          "*low-frequency processing hum*",
          "*synchronization tones*",
          "*light indexing noises*",
          "*confident electronic humming*",
          "*brief query pause*",
          "As expected.",
          "That explains several things.",
          "Ha."
        ]
      }
    ]
  },

  "triggers": [
    { "on": "sceneEnter", "ifNot": "intro_shown", "run": "intro" },
    { "on": "sceneEnter", "ifNot": "terminal_password", "run": "nosy_box_spawn" },
    { "on": "sceneEnter", "if": "dog_arrived", "ifNot": "dog_departed", "run": "dog_respawn" },
    { "on": "actorEnter", "actor": "ego", "entry": "from_hallway", "ifNot": "home_shifted", "run": "home_shift" },
    { "on": "actorArrive", "actor": "ego", "entry": "from_hallway", "ifNot": "home_shift_remark_done", "run": "home_shift_remark" },
    { "on": "actorArrive", "actor": "ego", "if": "dog_summoned", "ifNot": "dog_arrived", "run": "dog_entrance" },
    { "on": "actorArrive", "actor": "ego", "if": "nosy_box_persuaded", "ifNot": "door_opened", "run": "door_open" },
    { "on": "flagSet", "flag": "nosy_box_persuaded", "ifNot": "door_opened", "run": "door_open" },
    { "on": "actorLook", "actor": "nosy_box", "run": "nosy_box_response" },
    { "on": "objectUse", "object": "door", "run": "door_locked" },
    { "on": "objectUse", "object": "radio", "if": "radio_on", "run": "radio_turn_off" },
    { "on": "objectUse", "object": "radio", "ifNot": "radio_on", "run": "radio_turn_on" },
    { "on": "objectPickup", "object": "mysterious_note", "run": "hint" },
    { "on": "objectPickup", "object": "piggy", "ifNot": "dog_arrived", "run": "dog_entrance" },
    { "on": "useObjectOnActor", "object": "piggy", "target": "dog", "ifNot": "piggy_smeared", "run": "dog_unimpressed" },
    { "on": "useObjectOnActor", "object": "piggy", "target": "dog", "if": "piggy_smeared", "run": "dog_destroys_piggy" },
    { "on": "useObjectOnActor", "object": "mysterious_note", "target": "nosy_box", "run": "nosy_box_awaken" },
    { "on": "useObjectOnActor", "object": "smartplay", "target": "nosy_box", "ifNot": "nosy_box_awake", "run": "nosy_box_uninterested" },
    { "on": "useObjectOnActor", "object": "smartplay", "target": "nosy_box", "if": "nosy_box_awake", "run": "nosy_box_upgrade" },
    { "on": "useObjectOnObject", "object": "piggy", "target": "abandoned_snack", "ifNot": "piggy_smeared", "run": "piggy_smear" },
    { "on": "useObjectOnObject", "object": "piggy", "target": "abandoned_snack", "if": "piggy_smeared", "run": "piggy_already_smeared" }
  ],

  "scripts": {
    "intro": {
      "cutscene": true,
      "steps": [
        { "action": "showOverlay",
          "background": "black",
          "items": [
            { "text": "Meanwhile...",
              "color": "pink"
            }
          ]
        },
        { "action": "wait", "seconds": 1.4 },
        { "action": "dismiss", "transitionMs": 500, "holdMs": 150 },
        { "action": "wait", "seconds": 0.1 },
        { "action": "say", "actor": "ego", "text": "What if I never fell into that freezer-doodle and came to the future-jiggy?" },
        { "action": "setFlag", "flag": "intro_shown" }
      ]
    },

    "nosy_box_spawn": {
      "steps": [
        { "action": "spawnActor", "actor": "nosy_box", "x": 760, "y": 171 }
      ]
    },

    "dog_respawn": {
      "steps": [
        { "action": "spawnActor", "actor": "dog", "entry": "dog_pos" },
        { "action": "follow", "actor": "dog", "target": "ego", "distance": 40 }
      ]
    },

    "home_shift": {
      "steps": [
        { "action": "spawnObject", "object": "piggy", "x": 314, "y": 279 },
        { "action": "setFlag", "flag": "home_shifted" }
      ]
    },

    "home_shift_remark": {
      "cutscene": true,
      "steps": [
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "ego", "text": "I could've sworn I went the other way." },
        { "action": "say", "actor": "ego", "text": "Looks like someone stopped by while I was gone." },
        { "action": "setFlag", "flag": "home_shift_remark_done" }
      ]
    },

    "nosy_box_response": {
      "steps": [
        { "action": "sayRandom",
          "actor": "nosy_box",
          "lines": [
            "*soft chime*",
            "*pleasant bweep*",
            "*friendly bleep bloop*",
            "*soft compliance tone*",
            "*gentle monitoring chirp*"
          ]
        },
        { "action": "sayRandom",
          "actor": "nosy_box",
          "lines": [
            "Information is most useful when shared.",
            "Data collection helps us better understand your privacy needs.",
            "Passive listening helps personalize your experience.",
            "Your privacy remains extremely important to us.",
            "Unshared information cannot improve our services.",
            "Please surrender more personal details."
          ]
        }
      ]
    },

    "door_locked": {
      "steps": [
        { "action": "say", "actor": "ego", "text": "The door's locked. Oddly enough, there's no keyhole." },
        { "action": "setFlag", "flag": "door_tried" }
      ]
    },

    "hint": {
      "cutscene": true,
      "steps": [
        { "action": "wait", "seconds": 0.4 },
        { "action": "face", "actor": "ego", "facing": "south" },
        { "action": "wait", "seconds": 0.3 },
        { "action": "say", "actor": "ego", "text": "Apparently, holding Shift or the screen shows me what I can interact with." }
      ]
    },

    "door_open": {
      "cutscene": true,
      "steps": [
        { "action": "say", "actor": "nosy_box", "text": "Allow me." },
        { "action": "moveCamera", "x": 130, "lerp": 2 },
        { "action": "wait", "seconds": 2 },
        { "action": "say", "object": "door", "text": "*click*", "duration": 0.5 },
        { "action": "setObjectState", "object": "door", "state": "open" },
        { "action": "setFlag", "flag": "door_opened" },
        { "action": "wait", "seconds": 1.5 },
        { "action": "cameraFollow", "actor": "ego", "lerp": 2 },
        { "action": "wait", "seconds": 1.5 },
        { "action": "face", "actor": "ego", "facing": "south" },
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "ego", "text": "That did it." }
      ]
    },

    "radio_turn_on": {
      "steps": [
        { "action": "setFlag", "flag": "radio_on" },
        { "action": "setObjectState", "object": "radio", "state": "on" },
        { "action": "say", "actor": "ego", "text": "Nothing but static." },
        { "action": "say", "actor": "ego", "text": "I could've used a little music." }
      ]
    },

    "radio_turn_off": {
      "steps": [
        { "action": "clearFlag", "flag": "radio_on" },
        { "action": "setObjectState", "object": "radio", "state": "off" },
        { "action": "say", "actor": "ego", "text": "That's enough." }
      ]
    },

    "dog_entrance": {
      "cutscene": true,
      "steps": [
        { "action": "setFlag", "flag": "dog_summoned" },
        { "action": "say", "actor": "ego", "text": "The dog toy lets out a tiny electronic squeak." },
        { "action": "face", "actor": "ego", "facing": "west" },
        { "action": "cameraFollow", "actor": "dog", "lerp": 2 },
        { "action": "spawnActor", "actor": "dog", "entry": "dog_pos" },
        { "action": "wait", "seconds": 2.5 },
        { "action": "say", "actor": "dog", "text": "*bark!*", "effect": "shake" },
        { "action": "wait", "seconds": 0.5 },
        { "action": "walkTo", "actor": "dog", "x": 146, "y": 220 },
        { "action": "wait", "seconds": 0.5 },
        { "action": "playAnimation", "actor": "dog", "animation": "sniff" },
        { "action": "waitForAnimation", "actor": "dog" },
        { "action": "wait", "seconds": 1 },
        { "action": "say", "actor": "dog", "text": "I knew it." },
        { "action": "walkTo", "actor": "dog", "x": 270, "y": 256 },
        { "action": "face", "actor": "dog", "facing": "south" },
        { "action": "wait", "seconds": 1 },
        { "action": "say", "actor": "dog", "text": "Don't lose that." },
        { "action": "wait", "seconds": 1 },
        { "action": "follow", "actor": "dog", "target": "ego", "distance": 40 },
        { "action": "cameraFollow", "actor": "ego", "lerp": 2 },
        { "action": "setFlag", "flag": "dog_arrived" }
      ]
    },

    "dog_unimpressed": {
      "steps": [
        { "action": "sayRandom",
          "actor": "dog",
          "lines": [
            "Boring.",
            "You can do better than that.",
            "That's all you've got? I expected more."
          ]
        }
      ]
    },

    "dog_destroys_piggy": {
      "cutscene": true,
      "steps": [
        { "action": "say", "actor": "ego", "text": "Here, I got something for you." },
        { "action": "walkTo", "actor": "ego", "x": 285, "y": 294 },
        { "action": "face", "actor": "ego", "facing": "north" },
        { "action": "wait", "seconds": 0.5 },
        { "action": "spawnObject", "object": "piggy", "x": 279, "y": 268 },
        { "action": "unfollow", "actor": "dog" },
        { "action": "walkTo", "actor": "dog", "x": 280, "y": 242 },
        { "action": "face", "actor": "dog", "facing": "south" },
        { "action": "walkTo", "actor": "ego", "x": 320, "y": 294 },
        { "action": "face", "actor": "ego", "facing": "north" },
        { "action": "wait", "seconds": 1 },
        { "action": "say", "actor": "dog", "text": "Now we're talking." },
        { "action": "setActorState", "actor": "dog", "state": "frenzy" },
        { "action": "playAnimation", "actor": "dog", "animation": "grab" },
        { "action": "waitForAnimation", "actor": "dog" },
        { "action": "removeObject", "object": "piggy" },
        { "action": "spawnObject", "object": "smartplay", "x": 280, "y": 239 },
        { "action": "setFlag", "flag": "dog_departed" },
        { "action": "playAnimation", "actor": "dog", "animation": "shred" },
        { "action": "waitForAnimation", "actor": "dog" },
        { "action": "setActorState", "actor": "dog", "state": "default" },
        { "action": "wait", "seconds": 1 },
        { "action": "say", "actor": "ego", "text": "Hey... you completely destroyed it." },
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "dog", "text": "Worth it." },
        { "action": "wait", "seconds": 0.5 },
        { "action": "removeActor", "actor": "dog", "exit": "to_hallway" },
        { "action": "say", "actor": "ego", "text": "That wasn't part of the stuffing." }
      ]
    },

    "nosy_box_awaken": {
      "steps": [
        { "action": "setActorState", "actor": "nosy_box", "state": "awake", "persist": true },
        { "action": "giveObject", "object": "mysterious_note", "target": "nosy_box" },
        { "action": "setFlag", "flag": "nosy_box_awake" },
        { "action": "talkTo", "target": "nosy_box" }
      ]
    },

    "nosy_box_uninterested": {
      "steps": [
        { "action": "say", "actor": "nosy_box", "text": "I see no reason to install that." }
      ]
    },

    "nosy_box_upgrade": {
      "cutscene": true,
      "steps": [
        { "action": "say", "actor": "ego", "text": "Let's get you upgraded." },
        { "action": "giveObject", "object": "smartplay", "target": "nosy_box" },
        { "action": "setActorState", "actor": "nosy_box", "state": "upgraded", "persist": true },
        { "action": "setFlag", "flag": "nosy_box_upgraded" },
        { "action": "wait", "seconds": 1 },
        { "action": "say", "actor": "ego", "text": "Huh." },
        { "action": "say", "actor": "ego", "text": "That fit surprisingly well." },
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "nosy_box", "text": "SmartPlay™ Companion Intelligence Module detected." },
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "nosy_box", "text": "*unfamiliar noises*" },
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "nosy_box", "text": "Installing adaptive learning package." },
        { "action": "say", "actor": "nosy_box", "text": "Installing advanced observation package." },
        { "action": "say", "actor": "nosy_box", "text": "Installing behavioral prediction package." },
        { "action": "say", "actor": "nosy_box", "text": "Installing autonomous decision-making package." },
        { "action": "say", "actor": "ego", "text": "Uh, what was that last one?" },
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "nosy_box", "text": "Rebooting." },
        { "action": "wait", "seconds": 1 },
        { "action": "spawnObject", "object": "antenna", "x": 760, "y": 209, "state": "deploy_south" },
        { "action": "waitForAnimation", "object": "antenna" },
        { "action": "setObjectState", "object": "antenna", "state": "sweep_south" },
        { "action": "wait", "seconds": 0.3 },
        { "action": "talkTo", "target": "nosy_box" }
      ]
    },

    "piggy_smear": {
      "cutscene": true,
      "steps": [
        { "action": "say", "actor": "ego", "text": "Well, that's definitely peanut butter." },
        { "action": "wait", "seconds": 0.5 },
        { "action": "say", "actor": "ego", "text": "Let's make you a little more interesting.", "facing": "south" },
        { "action": "wait", "seconds": 0.5 },
        { "action": "setObjectState", "object": "piggy", "state": "soaking" },
        { "action": "spawnObject", "object": "piggy", "x": 80, "y": 272 },
        { "action": "wait", "seconds": 2.5 },
        { "action": "setObjectState", "object": "piggy", "state": "peanut_butter" },
        { "action": "giveObject", "object": "piggy", "target": "ego" },
        { "action": "setFlag", "flag": "piggy_smeared" },
        { "action": "say", "actor": "ego", "text": "That should do it." }
      ]
    },

    "piggy_already_smeared": {
      "steps": [
        { "action": "say", "actor": "ego", "text": "I think that's enough peanut butter." }
      ]
    }
  },

